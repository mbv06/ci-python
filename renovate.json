{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "schedule": ["before 5am on the first day of the month"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Stay on the current Python minor lines; major/minor Python bumps are a deliberate decision, not an automated one.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Stay on the Node.js 24 line; major bumps are a deliberate decision.",
      "matchDatasources": ["docker"],
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group all non-major updates into a single PR",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "all non-major dependencies"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track digest-pinned Python matrix bases (PYTHON_IMAGE_*) in the Dockerfile.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=docker depName=(?<depName>\\S+)\\s+ARG [A-Z0-9_]+=(?:[^:@\\s]+/)*[^:@\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track tool versions annotated with # renovate: in the Dockerfile (npm, pip).",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>npm|pypi) depName=(?<depName>\\S+?)(?: versioning=(?<versioning>[a-z-]+?))?(?: extractVersion=(?<extractVersion>\\S+?))?\\s+ARG [A-Z0-9_]+=(?<currentValue>\\S+)"
      ]
    }
  ]
}
